# ═══════════════════════════════════════════
# Cloudflare Workers Environment Variables
# ═══════════════════════════════════════════
# Copy this file to .env and fill in the values.
# For Workers deployment, use `wrangler secret put <KEY>` for secrets.

# ─── AI Provider ───
AI_PROVIDER=gemini                    # gemini | claude | openai
GEMINI_API_KEY=
CLAUDE_API_KEY=                       # Optional
OPENAI_API_KEY=                       # Optional

# ─── OAuth: Google ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth: GitHub ───
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Auth ───
JWT_SECRET=                           # Random string, min 32 chars

# ─── External APIs ───
SUPADATA_API_KEY=                     # YouTube transcript API
APIFY_API_TOKEN=                      # Optional fallback

# ─── Config ───
FRONTEND_URL=https://eng-learner.vercel.app
ENVIRONMENT=production
R2_PUBLIC_URL=                        # Your R2 public access URL

# ─── Cloudflare (for CI/CD) ───
CLOUDFLARE_API_TOKEN=                 # Used in GitHub Actions
CLOUDFLARE_ACCOUNT_ID=
